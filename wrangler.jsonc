{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "peak-lake-blog",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-04-15",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": ".cloudflare/assets",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api", "/api/*", "/_vercel/*", "/_vitals/*"]
  },
  "vars": { "LEGACY_ORIGIN": "https://www.peak-lake.com", "READ_ONLY_ORIGIN": "false" },
  "env": {
    "preview": {
      "name": "peak-lake-blog-preview",
      "workers_dev": true,
      "preview_urls": false,
      "routes": [],
      "vars": { "LEGACY_ORIGIN": "https://www.peak-lake.com", "READ_ONLY_ORIGIN": "true" }
    },
    "production": {
      "name": "peak-lake-blog",
      "workers_dev": true,
      "preview_urls": false,
      "routes": [{ "pattern": "www.peak-lake.com/*", "zone_name": "peak-lake.com" }],
      "vars": { "LEGACY_ORIGIN": "https://www.peak-lake.com", "READ_ONLY_ORIGIN": "false" }
    }
  }
}
