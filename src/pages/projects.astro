---
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Icon from "../components/Icon.astro";
import { projects } from "../data/projects";
import { projectsPageJsonLd } from "../lib/product-ld";

const desc =
  "One PC 的开源与个人产品展示：Anpai.Life 任务日历、OPC Skills 研发流水线，以及统一多模型接入的 AI Gateway。";
const softwareLd = projectsPageJsonLd({
  projects,
  isEn: false,
  authorUrl: new URL("/", Astro.site).href
});
---
<Base title="开源项目" description={desc} altLocaleUrl="/en/projects/">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(softwareLd)} />
  <section class="page">
    <div class="section-head">
      <span class="eyebrow"><Icon name="boxes" size={14} />开源项目</span>
      <h1 style="margin-top:14px">我做的东西</h1>
      <p>这些是我开源和维护的项目，围绕 AI、邮件和开发者效率。OPC Skills 有独立介绍页；Anpai.Life 与 AI Gateway 分别在自己的产品站。</p>
    </div>
    <div class="grid cols-3">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>
</Base>
