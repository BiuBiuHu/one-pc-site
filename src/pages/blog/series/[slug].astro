---
import Base from "../../../layouts/Base.astro";
import SeriesPage from "../../../components/SeriesPage.astro";
import { getCollection } from "astro:content";
import { collectSeries, seriesHref } from "../../../lib/blog.js";

export async function getStaticPaths() {
  const all = await getCollection("blog");
  const zh = all.filter((p) => (p.data.lang ?? "zh") === "zh" && !p.data.draft);
  const enSlugs = new Set(
    collectSeries(
      all.filter((p) => p.data.lang === "en" && !p.data.draft),
      { min: 1 }
    ).map((s) => s.slug)
  );
  return collectSeries(zh, { min: 1 }).map((series) => ({
    params: { slug: series.slug },
    props: { series, hasEn: enSlugs.has(series.slug) }
  }));
}

const { series, hasEn } = Astro.props;
const altLocaleUrl = hasEn ? seriesHref("en", series.name) : "/en/blog/";
const localeUrls = {
  zh: seriesHref("zh", series.name),
  en: hasEn ? seriesHref("en", series.name) : "/en/blog/"
};
---
<Base
  title={series.name}
  description={`专栏「${series.name}」，按学习顺序共 ${series.count} 篇。`}
  altLocaleUrl={altLocaleUrl}
  localeUrls={localeUrls}
>
  <SeriesPage lang="zh" series={series} />
</Base>
