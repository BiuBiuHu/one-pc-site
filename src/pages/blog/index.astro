---
import Base from "../../layouts/Base.astro";
import ArchiveCard from "../../components/ArchiveCard.astro";
import { getCollection } from "astro:content";
import { collectSeries, listArchiveCategories, seriesHref, ZH_CATEGORY_ORDER } from "../../lib/blog.js";

const posts = (await getCollection("blog"))
  .filter((p) => (p.data.lang ?? "zh") === "zh" && !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// 按分类归档
const groups = new Map();
for (const p of posts) {
  const cat = p.data.category || "其他";
  if (!groups.has(cat)) groups.set(cat, []);
  groups.get(cat).push(p);
}
const categories = listArchiveCategories(groups, ZH_CATEGORY_ORDER);
const seriesList = collectSeries(posts);

const fmt = (d) =>
  d.toLocaleDateString("zh-CN", { year: "numeric", month: "2-digit", day: "2-digit" }).replace(/\//g, "-");

const slug = (s, i) => `cat-${i}`;
---
<Base title="博客" altLocaleUrl="/en/blog/">
  <section class="page">
    <header class="archive-head">
      <h1>目录与归档</h1>
      <p class="archive-count">{posts.length} 篇</p>
    </header>

    <div class="archive-layout">
      <aside class="archive-toc">
        <div class="toc-label">分类目录</div>
        <nav class="toc-nav">
          {categories.map((cat, i) => (
            <a href={`#${slug(cat, i)}`} class="toc-link">
              {cat}
              <span class="toc-count">{(groups.get(cat) || []).length}</span>
            </a>
          ))}
        </nav>
        {seriesList.length > 0 && (
          <div class="archive-series">
            <div class="toc-label">专栏</div>
            <nav class="toc-nav">
              {seriesList.map((s) => (
                <a class="toc-link" href={seriesHref("zh", s.name)}>
                  {s.name}
                  <span class="toc-count">{s.count}</span>
                </a>
              ))}
            </nav>
          </div>
        )}
      </aside>

      <div class="archive-main">
        {categories.map((cat, i) => (
          <section class="archive-group" id={slug(cat, i)}>
            <h3 class="archive-cat">{cat}</h3>
            <div class="post-list archive-posts">
              {(groups.get(cat) || []).map((post) => (
                <ArchiveCard
                  href={`/blog/${post.id}`}
                  date={fmt(post.data.date)}
                  title={post.data.title}
                  excerpt={post.data.excerpt}
                  seriesName={post.data.series}
                  seriesHref={post.data.series ? seriesHref("zh", post.data.series) : undefined}
                />
              ))}
              {(groups.get(cat) || []).length === 0 && (
                <p class="archive-empty">还没有文章。</p>
              )}
            </div>
          </section>
        ))}
      </div>
    </div>
  </section>
</Base>
