---
import Base from "../../layouts/Base.astro";
import Comments from "../../components/Comments.astro";
import Icon from "../../components/Icon.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const tocItems = headings.filter((h) => h.depth >= 2 && h.depth <= 3);

const fmt = (d) =>
  d.toLocaleDateString("zh-CN", { year: "numeric", month: "2-digit", day: "2-digit" }).replace(/\//g, "-");
---
<Base title={post.data.title} description={post.data.excerpt}>
  <section class="page">
    <div class={`article-layout ${tocItems.length ? "has-toc" : ""}`}>
      {
        tocItems.length > 0 && (
          <aside class="toc">
            <a class="back-link" href="/blog">
              <Icon name="arrow-left" size={15} />返回博客
            </a>
            <div class="toc-label">目录</div>
            <nav class="toc-nav">
              {tocItems.map((h) => (
                <a href={`#${h.slug}`} class={`toc-link toc-d${h.depth}`}>
                  {h.text}
                </a>
              ))}
            </nav>
          </aside>
        )
      }

      <div class="article">
        {tocItems.length === 0 && (
          <a class="back-link" href="/blog"><Icon name="arrow-left" size={15} />返回博客</a>
        )}
        <header class="article-head">
          <div class="date">{fmt(post.data.date)}</div>
          <h1>{post.data.title}</h1>
        </header>
        <div class="prose">
          <Content />
        </div>
      </div>
    </div>
    <Comments slug={post.id} />
  </section>

  <script is:inline>
    // mermaid 代码块渲染：Astro 只把 ```mermaid 做了语法高亮，这里用 mermaid.js 把 <pre data-language="mermaid"> 替换成 SVG 图
    (function () {
      var blocks = document.querySelectorAll('pre[data-language="mermaid"]');
      if (!blocks.length) return;

      function renderAll() {
        if (!window.mermaid) return;
        mermaid.initialize({ startOnLoad: false, theme: "default" });
        var i = 0;
        Array.prototype.forEach.call(blocks, function (pre) {
          var codeEl = pre.querySelector("code");
          var code = codeEl ? codeEl.textContent : pre.textContent;
          mermaid
            .render("mermaid-" + i++, code)
            .then(function (r) {
              var wrap = document.createElement("div");
              wrap.className = "mermaid-wrap";
              wrap.innerHTML = r.svg;
              pre.replaceWith(wrap);
            })
            .catch(function (e) {
              console.error("mermaid render failed:", e);
            });
        });
      }

      var s = document.createElement("script");
      s.src = "https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js";
      s.onload = renderAll;
      s.onerror = function () {
        console.error("mermaid script load failed");
      };
      document.head.appendChild(s);
    })();
  </script>
</Base>
