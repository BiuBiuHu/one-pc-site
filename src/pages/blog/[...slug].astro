---
import Base from "../../layouts/Base.astro";
import ArticlePost from "../../components/ArticlePost.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const zh = posts.filter((p) => (p.data.lang ?? "zh") === "zh");
  const enIds = new Set(
    posts.filter((p) => p.data.lang === "en").map((p) => p.id.replace(/-en$/, ""))
  );
  return zh.map((post) => ({
    params: { slug: post.id },
    props: { post, hasEn: enIds.has(post.id) }
  }));
}

const { post, hasEn } = Astro.props;
const slug = post.id.replace(/\.en$/, "");
const altLocaleUrl = hasEn ? `/en/blog/${slug}/` : "/en/blog/";
---

<Base
  title={post.data.title}
  description={post.data.excerpt}
  type="article"
  image={post.data.ogImage}
  altLocaleUrl={altLocaleUrl}
>
  <ArticlePost post={post} lang="zh" />
</Base>
