---
import Base from "../../layouts/Base.astro";
import SeriesIndex from "../../components/SeriesIndex.astro";
import { getCollection } from "astro:content";
import { seriesIndexHref } from "../../lib/blog.js";

const posts = (await getCollection("blog")).filter((p) => (p.data.lang ?? "zh") === "zh" && !p.data.draft);
const localeUrls = { zh: seriesIndexHref("zh"), en: seriesIndexHref("en") };
---
<Base
  title="专栏"
  description="已经成体系的学习路径：Agent 开发、全栈工程、WebView 与客户端。按课程模块推进，不是另一份博客归档。"
  altLocaleUrl={localeUrls.en}
  localeUrls={localeUrls}
>
  <SeriesIndex lang="zh" posts={posts} />
</Base>
