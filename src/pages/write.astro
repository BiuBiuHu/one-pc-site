---
import Base from "../layouts/Base.astro";
// 写作页：Vditor 即时渲染（IR）+ 草稿 + 沉浸 + 「我的文章」抽屉（编辑/删除）。
// Vditor 经 CDN 引入（不打包），所有编辑器代码在 <script is:inline> 客户端执行，
// 避免 Astro 静态构建在 Node 端引用 window/document 而失败。
---
<Base title="写作">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/vditor@3.11.2/dist/index.css" />

  <section class="page write-page">
    <div class="write-topbar">
      <a href="/blog" class="back-link">← 博客</a>
      <div class="topbar-right">
        <span class="write-hint" id="write-hint" role="status" aria-live="polite"></span>
        <button
          type="button"
          class="btn ghost sm"
          id="my-posts-btn"
          aria-label="我的文章"
          title="管理已发布文章（编辑 / 删除）"
        >
          我的文章
        </button>
        <button
          type="button"
          class="btn ghost sm zen-toggle"
          id="zen-btn"
          aria-label="沉浸模式"
          title="沉浸模式（Esc 退出）"
        >
          沉浸
        </button>
      </div>
    </div>

    <!-- 编辑模式提示条 -->
    <div class="edit-banner" id="edit-banner" hidden>
      <span>正在编辑：<strong id="edit-banner-title"></strong></span>
      <button type="button" class="link-btn" id="edit-cancel">取消，写新文章</button>
    </div>

    <div class="write-canvas">
      <input
        class="write-title"
        id="f-title"
        type="text"
        placeholder="标题"
        aria-label="文章标题"
        autocomplete="off"
      />
      <div id="vditor" aria-label="正文编辑器"></div>
    </div>

    <form class="write-drawer" id="write-form">
      <div class="drawer-inner">
        <details class="drawer-options">
          <summary>摘要 · 分类</summary>
          <label class="field">
            <span>摘要</span>
            <input type="text" id="f-excerpt" placeholder="一句话摘要" autocomplete="off" required />
          </label>
          <label class="field">
            <span>分类</span>
            <select id="f-category">
              <option value="思考">思考</option>
              <option value="AI">AI</option>
              <option value="工程">工程</option>
              <option value="__other">其他…</option>
            </select>
            <input
              type="text"
              id="f-category-other"
              placeholder="自定义分类"
              hidden
              autocomplete="off"
            />
          </label>
        </details>
        <div class="drawer-actions">
          <label class="field write-pw">
            <span>写作口令</span>
            <input
              type="password"
              id="f-password"
              required
              autocomplete="current-password"
              placeholder="发布口令"
            />
          </label>
          <button type="submit" class="btn primary" id="write-submit">发布</button>
        </div>
      </div>
    </form>
  </section>

  <!-- 「我的文章」抽屉 -->
  <div class="drawer-overlay" id="drawer-overlay" hidden></div>
  <aside class="posts-drawer" id="posts-drawer" aria-hidden="true">
    <div class="drawer-head">
      <h3>我的文章<span class="drawer-count" id="drawer-count"></span></h3>
      <div class="drawer-head-actions">
        <button type="button" class="btn ghost sm" id="new-post-btn">写新文章</button>
        <button type="button" class="icon-btn" id="drawer-close" aria-label="关闭">✕</button>
      </div>
    </div>
    <div class="drawer-body" id="posts-list"></div>
  </aside>

  <style>
    .write-page {
      position: relative;
      padding: 16px 0 0;
      min-height: calc(100vh - 200px);
    }

    .write-topbar {
      max-width: 960px;
      margin: 0 auto 8px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
    }
    .back-link {
      font-size: 13px;
      color: var(--muted);
      text-decoration: none;
    }
    .back-link:hover {
      color: var(--brand);
    }
    .topbar-right {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .write-hint {
      font-size: 13px;
      color: var(--muted);
      min-height: 18px;
    }
    .write-hint.ok {
      color: var(--green);
    }
    .write-hint.err {
      color: var(--amber);
    }
    .write-hint a {
      color: var(--brand);
      text-decoration: underline;
    }
    .zen-toggle {
      white-space: nowrap;
    }

    .edit-banner {
      max-width: 960px;
      margin: 0 auto 8px;
      background: var(--brand-soft);
      border: 1px solid var(--brand-line);
      border-radius: var(--radius-sm);
      padding: 8px 12px;
      font-size: 13px;
      color: var(--text-2);
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
    }
    .edit-banner strong {
      color: var(--text);
      font-weight: 600;
    }
    .link-btn {
      background: none;
      border: none;
      cursor: pointer;
      font-size: 13px;
      color: var(--brand);
      padding: 0;
      white-space: nowrap;
    }
    .link-btn:hover {
      text-decoration: underline;
    }

    .write-canvas {
      max-width: 960px;
      margin: 0 auto;
    }
    .write-title {
      width: 100%;
      font-size: 30px;
      font-weight: 700;
      line-height: 1.3;
      border: none;
      outline: none;
      background: transparent;
      padding: 8px 0 16px;
      color: var(--text);
    }
    .write-title::placeholder {
      color: var(--muted-2);
      font-weight: 400;
    }

    /* Vditor IR 渲染对齐站点 .prose —— 容器内子节点由 Vditor 动态生成，必须 :global */
    :global(#vditor) {
      min-height: 60vh;
      border: none !important;
    }
    :global(#vditor .vditor-toolbar) {
      background: transparent;
      border: none;
      padding: 0 0 10px;
    }
    :global(#vditor .vditor-content) {
      background: transparent;
      border: none;
    }
    :global(#vditor .vditor-reset),
    :global(#vditor .vditor-ir) {
      font-size: 16px;
      line-height: 1.75;
      color: var(--text-2);
    }
    :global(#vditor .vditor-reset h1),
    :global(#vditor .vditor-reset h2),
    :global(#vditor .vditor-reset h3),
    :global(#vditor .vditor-ir h1),
    :global(#vditor .vditor-ir h2),
    :global(#vditor .vditor-ir h3) {
      color: var(--text);
    }
    :global(#vditor .vditor-reset blockquote),
    :global(#vditor .vditor-ir blockquote) {
      border-left: 3px solid var(--brand-line);
      background: var(--brand-soft);
      color: var(--text-2);
      padding: 0.5em 0.9em;
      border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
      margin: 1em 0;
    }
    :global(#vditor .vditor-reset a),
    :global(#vditor .vditor-ir a) {
      color: var(--brand);
      text-decoration: underline;
      text-underline-offset: 2px;
    }
    :global(#vditor .vditor-reset code),
    :global(#vditor .vditor-ir code) {
      background: var(--code-bg);
      color: var(--text);
      padding: 0.15em 0.35em;
      border-radius: 4px;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    }
    :global(#vditor .vditor-reset table th),
    :global(#vditor .vditor-ir table th) {
      background: var(--bg-subtle);
    }

    /* 发布抽屉：sticky 在视口底部，写作时折叠、发布时展开 */
    .write-drawer {
      position: sticky;
      bottom: 0;
      background: var(--surface);
      border-top: 1px solid var(--border);
      padding: 12px 0;
      margin-top: 32px;
      box-shadow: var(--shadow-sm);
      z-index: 10;
    }
    .drawer-inner {
      max-width: 960px;
      margin: 0 auto;
    }
    .drawer-options summary {
      font-size: 13px;
      font-weight: 600;
      color: var(--text-2);
      cursor: pointer;
      padding: 4px 0;
      list-style: none;
    }
    .drawer-options summary::-webkit-details-marker {
      display: none;
    }
    .drawer-options[open] summary {
      margin-bottom: 12px;
    }
    .drawer-options .field {
      margin-bottom: 10px;
    }
    .drawer-options .field:last-child {
      margin-bottom: 0;
    }
    .drawer-actions {
      display: flex;
      align-items: flex-end;
      gap: 12px;
      margin-top: 12px;
    }
    .drawer-actions .write-pw {
      flex: 1;
    }
    .drawer-actions .btn {
      flex-shrink: 0;
    }

    /* 「我的文章」抽屉 */
    .drawer-overlay {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.4);
      z-index: 50;
    }
    .posts-drawer {
      position: fixed;
      top: 0;
      right: 0;
      bottom: 0;
      width: min(560px, 92vw);
      background: var(--surface);
      box-shadow: var(--shadow-lg);
      z-index: 51;
      display: flex;
      flex-direction: column;
      transform: translateX(100%);
      transition: transform 0.25s ease;
    }
    .posts-drawer.open {
      transform: translateX(0);
    }
    .drawer-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 16px 20px;
      border-bottom: 1px solid var(--border);
    }
    .drawer-head h3 {
      font-size: 16px;
      margin: 0;
    }
    .drawer-head-actions {
      display: flex;
      gap: 8px;
      align-items: center;
    }
    .icon-btn {
      background: none;
      border: none;
      cursor: pointer;
      font-size: 18px;
      color: var(--muted);
      padding: 4px 8px;
      line-height: 1;
    }
    .icon-btn:hover {
      color: var(--text);
    }
    .drawer-body {
      flex: 1;
      overflow-y: auto;
      padding: 12px 16px;
    }
    .post-row {
      position: relative;
      padding: 12px 12px 12px 14px;
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      margin-bottom: 10px;
      display: flex;
      gap: 10px;
      align-items: flex-start;
      cursor: pointer;
      overflow: hidden;
      transition: background 0.15s ease, border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
    }
    .post-row::before {
      content: "";
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 3px;
      background: transparent;
      transition: background 0.15s ease;
    }
    .post-row:hover {
      background: var(--bg-subtle);
      border-color: var(--border-strong);
      transform: translateY(-1px);
      box-shadow: var(--shadow-sm);
    }
    .post-row:hover::before {
      background: var(--brand-line);
    }
    .post-row.editing {
      background: var(--brand-soft);
      border-color: var(--brand-line);
    }
    .post-row.editing::before {
      background: var(--brand);
    }
    .post-row.confirming {
      background: #fffbeb;
      border-color: #fde68a;
      cursor: default;
      transform: none;
      box-shadow: none;
    }
    .post-row.confirming::before {
      background: var(--amber);
    }
    .post-row-main {
      flex: 1;
      min-width: 0;
    }
    .post-row-date {
      font-size: 12px;
      color: var(--muted);
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .post-cat {
      font-size: 11px;
      font-weight: 600;
      padding: 1px 8px;
      border-radius: 99px;
      line-height: 1.6;
    }
    .post-cat[data-cat="AI"] {
      background: #e0e7ff;
      color: #3730a3;
    }
    .post-cat[data-cat="工程"] {
      background: var(--green-soft);
      color: #047857;
    }
    .post-cat[data-cat="思考"] {
      background: #f3e8ff;
      color: #6b21a8;
    }
    .post-cat[data-cat="其他"] {
      background: var(--bg-section);
      color: var(--text-2);
    }
    .post-row-title {
      font-size: 14px;
      font-weight: 600;
      color: var(--text);
      margin: 4px 0 2px;
      word-break: break-word;
    }
    .post-row-excerpt {
      font-size: 12px;
      color: var(--text-2);
      overflow: hidden;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
    }
    .post-row-actions {
      display: flex;
      flex-direction: column;
      gap: 6px;
      flex-shrink: 0;
    }
    .confirm-text {
      font-size: 13px;
      color: var(--amber);
      font-weight: 600;
      padding: 8px 0;
    }
    .btn.danger {
      color: var(--amber);
    }
    .btn.danger:hover {
      background: #fffbeb;
      border-color: #fde68a;
    }
    .drawer-count {
      font-size: 13px;
      font-weight: 400;
      color: var(--muted);
      margin-left: 6px;
    }
    .drawer-empty {
      text-align: center;
      color: var(--muted);
      font-size: 13px;
      padding: 40px 0;
      line-height: 1.6;
    }

    /* 沉浸模式：隐藏全站 topbar/footer，写作区顶天立地 */
    :global(body.zen .topbar),
    :global(body.zen .footer) {
      display: none !important;
    }
    :global(body.zen .main) {
      padding-top: 0 !important;
    }
    :global(body.zen) .write-page {
      padding-top: 32px;
    }
    :global(body.zen) .back-link {
      display: none;
    }

    @media (max-width: 640px) {
      .write-title {
        font-size: 24px;
      }
      .drawer-actions {
        flex-direction: column;
        align-items: stretch;
      }
      .drawer-actions .btn {
        width: 100%;
      }
      .write-hint {
        display: none;
      }
    }
  </style>

  <script is:inline src="https://cdn.jsdelivr.net/npm/vditor@3.11.2/dist/index.min.js"></script>
  <script is:inline>
    (function () {
      var DRAFT_KEY = "write:draft:v1";
      var PROMPTS = [
        "今天想说什么？",
        "最近哪件事让你改变了想法？",
        "如果只能写一段，你会写什么？",
        "有什么是你以前相信、现在不信的？",
        "借这个机会，把脑子里那团乱麻理一理。",
        "你最近反复在想的一个问题是什么？",
        "写下第一句，剩下的会跟上来。",
        "假设没人会看到这篇，你想说什么？"
      ];
      var TOOLBAR = [
        "emoji", "headings", "bold", "italic", "link", "inline-code",
        "|", "list", "ordered-list", "check", "outdent", "indent",
        "|", "quote", "code", "line", "table",
        "|", "undo", "redo", "edit-mode",
        "|", "fullscreen", "preview"
      ];

      var hint = document.getElementById("write-hint");
      var fTitle = document.getElementById("f-title");
      var fExcerpt = document.getElementById("f-excerpt");
      var fCategory = document.getElementById("f-category");
      var fCategoryOther = document.getElementById("f-category-other");
      var fPassword = document.getElementById("f-password");
      var submitBtn = document.getElementById("write-submit");
      var zenBtn = document.getElementById("zen-btn");
      var form = document.getElementById("write-form");
      var editBanner = document.getElementById("edit-banner");
      var editBannerTitle = document.getElementById("edit-banner-title");
      var editCancel = document.getElementById("edit-cancel");
      var myPostsBtn = document.getElementById("my-posts-btn");
      var drawer = document.getElementById("posts-drawer");
      var overlay = document.getElementById("drawer-overlay");
      var drawerClose = document.getElementById("drawer-close");
      var newPostBtn = document.getElementById("new-post-btn");
      var postsList = document.getElementById("posts-list");

      var vditor = null;
      var saveTimer = null;
      var restoring = false;
      // 编辑态：有 editingSlug = 编辑模式（更新），无 = 新建模式
      var editingSlug = null;
      var editingSha = null;
      var editingDate = null;

      function escapeHtml(s) {
        return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) {
          return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
        });
      }

      function readDraft() {
        try {
          return JSON.parse(localStorage.getItem(DRAFT_KEY) || "null");
        } catch (e) {
          return null;
        }
      }
      function writeDraft() {
        if (!vditor) return;
        var d = {
          ts: Date.now(),
          title: fTitle.value,
          excerpt: fExcerpt.value,
          category: currentCategory(),
          body: vditor.getValue()
        };
        try {
          localStorage.setItem(DRAFT_KEY, JSON.stringify(d));
        } catch (e) {}
        var t = new Date();
        var hh = String(t.getHours()).padStart(2, "0");
        var mm = String(t.getMinutes()).padStart(2, "0");
        hint.textContent = "草稿已存于 " + hh + ":" + mm;
        hint.className = "write-hint ok";
      }
      function clearDraft() {
        try {
          localStorage.removeItem(DRAFT_KEY);
        } catch (e) {}
      }
      function currentCategory() {
        if (fCategory.value === "__other") {
          return (fCategoryOther.value || "").trim() || "思考";
        }
        return fCategory.value;
      }
      function restoreCategory(val) {
        if (!val) {
          fCategory.value = "思考";
          fCategoryOther.hidden = true;
          return;
        }
        var opts = Array.prototype.map.call(fCategory.options, function (o) {
          return o.value;
        });
        if (opts.indexOf(val) >= 0) {
          fCategory.value = val;
          fCategoryOther.hidden = true;
        } else {
          fCategory.value = "__other";
          fCategoryOther.hidden = false;
          fCategoryOther.value = val;
        }
      }
      function onInput() {
        if (restoring) return;
        hint.textContent = "保存中…";
        hint.className = "write-hint";
        clearTimeout(saveTimer);
        saveTimer = setTimeout(writeDraft, 600);
      }

      // 模式切换：edit = 编辑已有（更新），new = 新建
      function setMode(mode) {
        if (mode === "edit") {
          submitBtn.textContent = "更新";
          editBanner.hidden = false;
        } else {
          submitBtn.textContent = "发布";
          editBanner.hidden = true;
          editingSlug = null;
          editingSha = null;
          editingDate = null;
        }
      }
      // 清空编辑器，回到「写新文章」
      function newPost() {
        restoring = true;
        if (vditor) {
          vditor.setValue("");
          vditor.clearStack();
        }
        fTitle.value = "";
        fExcerpt.value = "";
        fCategory.value = "思考";
        fCategoryOther.hidden = true;
        fCategoryOther.value = "";
        clearDraft();
        setMode("new");
        restoring = false;
        hint.textContent = "";
      }

      // 标题、摘要、分类变更也纳入草稿（仅新建模式下；编辑模式不污染草稿）
      [fTitle, fExcerpt, fCategoryOther].forEach(function (el) {
        el.addEventListener("input", onInput);
      });
      fCategory.addEventListener("change", function () {
        fCategoryOther.hidden = fCategory.value !== "__other";
        if (fCategory.value === "__other") fCategoryOther.focus();
        onInput();
      });

      // 沉浸模式
      function toggleZen(force) {
        var on =
          typeof force === "boolean"
            ? force
            : !document.body.classList.contains("zen");
        document.body.classList.toggle("zen", on);
        zenBtn.textContent = on ? "退出沉浸" : "沉浸";
      }
      zenBtn.addEventListener("click", function () {
        toggleZen();
      });
      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape") {
          toggleZen(false);
          if (drawer.classList.contains("open")) closeDrawer();
        }
        if ((e.metaKey || e.ctrlKey) && (e.key === "s" || e.key === "S")) {
          e.preventDefault();
          writeDraft();
        }
      });

      // 「我的文章」抽屉
      function openDrawer() {
        overlay.hidden = false;
        drawer.classList.add("open");
        drawer.setAttribute("aria-hidden", "false");
        loadList();
      }
      function closeDrawer() {
        overlay.hidden = true;
        drawer.classList.remove("open");
        drawer.setAttribute("aria-hidden", "true");
      }
      async function loadList() {
        var pw = fPassword.value;
        if (!pw) {
          postsList.innerHTML =
            '<div class="drawer-empty">先在下方填写作口令，<br>再管理已发布文章。</div>';
          return;
        }
        postsList.innerHTML = '<div class="drawer-empty">加载中…</div>';
        try {
          var r = await fetch("/api/list?password=" + encodeURIComponent(pw));
          var d = await r.json();
          if (!d.ok) {
            postsList.innerHTML =
              '<div class="drawer-empty">❌ ' + escapeHtml(d.message || "加载失败") + "</div>";
            return;
          }
          renderList(d.items);
        } catch (e) {
          postsList.innerHTML = '<div class="drawer-empty">❌ 网络错误</div>';
        }
      }
      function renderList(items) {
        var count = document.getElementById("drawer-count");
        if (!items || !items.length) {
          if (count) count.textContent = "";
          postsList.innerHTML =
            '<div class="drawer-empty"><strong>还没有文章</strong><br>写一篇试试，发布后会出现在这里。</div>';
          return;
        }
        if (count) count.textContent = " · " + items.length + " 篇";
        postsList.innerHTML = "";
        items.forEach(function (it) {
          var row = document.createElement("div");
          row.className = "post-row" + (it.slug === editingSlug ? " editing" : "");
          var main = document.createElement("div");
          main.className = "post-row-main";
          var cat = it.category || "思考";
          main.innerHTML =
            '<div class="post-row-date">' + escapeHtml(it.date) +
            ' <span class="post-cat" data-cat="' + escapeHtml(cat) + '">' + escapeHtml(cat) + "</span></div>" +
            '<div class="post-row-title">' + escapeHtml(it.title) + "</div>" +
            '<div class="post-row-excerpt">' + escapeHtml(it.excerpt) + "</div>";
          var actions = document.createElement("div");
          actions.className = "post-row-actions";
          var editBtn = document.createElement("button");
          editBtn.className = "btn ghost sm";
          editBtn.textContent = "编辑";
          editBtn.addEventListener("click", function (e) {
            e.stopPropagation();
            editPost(it.slug);
          });
          var delBtn = document.createElement("button");
          delBtn.className = "btn ghost sm danger";
          delBtn.textContent = "删除";
          delBtn.addEventListener("click", function (e) {
            e.stopPropagation();
            askDelete(row, it.slug, it.title, it.sha);
          });
          // 点行主体（非按钮区）也进编辑
          row.addEventListener("click", function (e) {
            if (e.target.closest(".post-row-actions")) return;
            editPost(it.slug);
          });
          actions.appendChild(editBtn);
          actions.appendChild(delBtn);
          row.appendChild(main);
          row.appendChild(actions);
          postsList.appendChild(row);
        });
      }
      async function editPost(slug) {
        var pw = fPassword.value;
        if (!pw) {
          hint.textContent = "❌ 先填写作口令";
          hint.className = "write-hint err";
          return;
        }
        hint.textContent = "加载中…";
        hint.className = "write-hint";
        try {
          var r = await fetch(
            "/api/get?slug=" + encodeURIComponent(slug) + "&password=" + encodeURIComponent(pw)
          );
          var d = await r.json();
          if (!d.ok) {
            hint.textContent = "❌ " + (d.message || "加载失败");
            hint.className = "write-hint err";
            return;
          }
          restoring = true;
          vditor.setValue(d.body);
          fTitle.value = d.title;
          fExcerpt.value = d.excerpt;
          restoreCategory(d.category);
          editingSlug = d.slug;
          editingSha = d.sha;
          editingDate = d.date;
          setMode("edit");
          editBannerTitle.textContent = d.title;
          restoring = false;
          hint.textContent = "已加载，改完点「更新」";
          hint.className = "write-hint ok";
          closeDrawer();
        } catch (e) {
          hint.textContent = "❌ 网络错误";
          hint.className = "write-hint err";
        }
      }
      function askDelete(row, slug, title, sha) {
        row.classList.add("confirming");
        var main = row.querySelector(".post-row-main");
        var actions = row.querySelector(".post-row-actions");
        main.innerHTML =
          '<div class="confirm-text">确认删除《' + escapeHtml(title) + "》？不可恢复。</div>";
        actions.innerHTML = "";
        var yes = document.createElement("button");
        yes.className = "btn ghost sm danger";
        yes.textContent = "确认删除";
        yes.addEventListener("click", function (e) {
          e.stopPropagation();
          deletePost(slug, title, sha);
        });
        var no = document.createElement("button");
        no.className = "btn ghost sm";
        no.textContent = "取消";
        no.addEventListener("click", function (e) {
          e.stopPropagation();
          loadList();
        });
        actions.appendChild(yes);
        actions.appendChild(no);
      }
      async function deletePost(slug, title, sha) {
        var pw = fPassword.value;
        if (!pw) {
          hint.textContent = "❌ 先填写作口令";
          hint.className = "write-hint err";
          return;
        }
        hint.textContent = "删除中…";
        hint.className = "write-hint";
        // sha 可能为空（列表加载后文件被改动）；保险起见缺 sha 时先 get
        var finalSha = sha;
        try {
          if (!finalSha) {
            var gr = await fetch(
              "/api/get?slug=" + encodeURIComponent(slug) + "&password=" + encodeURIComponent(pw)
            );
            var gd = await gr.json();
            if (!gd.ok) {
              hint.textContent = "❌ " + (gd.message || "读取失败");
              hint.className = "write-hint err";
              loadList();
              return;
            }
            finalSha = gd.sha;
          }
          var r = await fetch("/api/delete", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ password: pw, slug: slug, sha: finalSha })
          });
          var d = await r.json();
          if (d.ok) {
            hint.textContent = "✅ 已删除《" + title + "》";
            hint.className = "write-hint ok";
            if (editingSlug === slug) newPost();
            loadList();
          } else {
            hint.textContent = "❌ " + (d.message || "删除失败");
            hint.className = "write-hint err";
            loadList();
          }
        } catch (e) {
          hint.textContent = "❌ 网络错误";
          hint.className = "write-hint err";
          loadList();
        }
      }

      myPostsBtn.addEventListener("click", openDrawer);
      drawerClose.addEventListener("click", closeDrawer);
      overlay.addEventListener("click", closeDrawer);
      newPostBtn.addEventListener("click", function () {
        newPost();
        closeDrawer();
      });
      editCancel.addEventListener("click", function () {
        newPost();
      });

      // 发布 / 更新：复用 /api/post（更新带 slug+sha+date）
      form.addEventListener("submit", async function (e) {
        e.preventDefault();
        var title = fTitle.value.trim();
        var body = vditor ? vditor.getValue() : "";
        if (!title) {
          hint.textContent = "❌ 还缺标题";
          hint.className = "write-hint err";
          fTitle.focus();
          return;
        }
        if (!body.trim()) {
          hint.textContent = "❌ 正文是空的";
          hint.className = "write-hint err";
          return;
        }
        var isUpdate = !!editingSlug;
        submitBtn.disabled = true;
        submitBtn.textContent = isUpdate ? "更新中…" : "发布中…";
        if (vditor) vditor.disabled();
        var payload = {
          password: fPassword.value,
          title: title,
          excerpt: fExcerpt.value,
          category: currentCategory(),
          body: body
        };
        if (isUpdate) {
          payload.slug = editingSlug;
          payload.sha = editingSha;
          payload.date = editingDate;
        }
        try {
          var r = await fetch("/api/post", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
          });
          var d = await r.json();
          if (d.ok) {
            if (isUpdate) {
              hint.innerHTML =
                '✅ 已更新！正在部署，稍后可访问 <a href="' + d.url + '">' + d.url + "</a>";
              hint.className = "write-hint ok";
              editingSha = d.sha; // 更新 sha，便于继续改后再更新
              editBannerTitle.textContent = title;
              if (vditor) vditor.enable();
            } else {
              hint.innerHTML =
                '✅ 已发布！正在部署，稍后可访问 <a href="' + d.url + '">' + d.url + "</a>";
              hint.className = "write-hint ok";
              restoring = true;
              clearDraft();
              if (vditor) {
                vditor.setValue("");
                vditor.clearStack();
                vditor.enable();
              }
              fTitle.value = "";
              fExcerpt.value = "";
              fPassword.value = "";
              fCategory.value = "思考";
              fCategoryOther.hidden = true;
              fCategoryOther.value = "";
              restoring = false;
            }
          } else {
            hint.textContent = "❌ " + (d.message || (isUpdate ? "更新失败" : "发布失败"));
            hint.className = "write-hint err";
            if (vditor) vditor.enable();
          }
        } catch (err) {
          hint.textContent = "❌ 网络错误，内容已保留";
          hint.className = "write-hint err";
          if (vditor) vditor.enable();
        }
        submitBtn.disabled = false;
        submitBtn.textContent = isUpdate ? "更新" : "发布";
      });

      // Vditor 就绪后初始化（CDN 同步加载，轮询兜底应对慢加载）
      function start() {
        if (typeof Vditor === "undefined") {
          return setTimeout(start, 50);
        }
        vditor = new Vditor("vditor", {
          height: "auto",
          mode: "ir",
          placeholder: PROMPTS[Math.floor(Math.random() * PROMPTS.length)],
          cache: { enable: false },
          counter: { enable: true, type: "markdown" },
          toolbar: TOOLBAR,
          toolbarConfig: { pin: true },
          // mermaid / katex / echarts 等渲染依赖默认从 unpkg 加载，国内不稳，这里指定走 jsdelivr
          cdn: "https://cdn.jsdelivr.net/npm/vditor@3.11.2",
          preview: { hljs: { lineNumber: false, style: "github-dark" } },
          input: onInput,
          after: function () {
            var d = readDraft();
            if (d && d.body) {
              restoring = true;
              vditor.setValue(d.body);
              fTitle.value = d.title || "";
              fExcerpt.value = d.excerpt || "";
              restoreCategory(d.category);
              restoring = false;
              var t = new Date(d.ts);
              var hh = String(t.getHours()).padStart(2, "0");
              var mm = String(t.getMinutes()).padStart(2, "0");
              hint.textContent = "已恢复草稿（" + hh + ":" + mm + "）";
              hint.className = "write-hint ok";
            }
          }
        });
      }
      start();
    })();
  </script>
</Base>
