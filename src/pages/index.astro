---
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SeriesCards from "../components/SeriesCards.astro";
import FriendsList from "../components/FriendsList.astro";
import Icon from "../components/Icon.astro";
import { getFeaturedProjects } from "../data/projects";
import { services } from "../data/services";
import { getCollection } from "astro:content";
import { collectCurriculumSeries } from "../lib/blog.js";

const featured = getFeaturedProjects(4);
const allPosts = (await getCollection("blog"))
  .filter((p) => (p.data.lang ?? "zh") === "zh" && !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const latest = allPosts.slice(0, 3);
const topServices = services.slice(0, 2);
const columns = collectCurriculumSeries(allPosts);

const fmt = (d) =>
  d.toLocaleDateString("zh-CN", { year: "numeric", month: "2-digit", day: "2-digit" }).replace(/\//g, "-");
---
<Base
  title="Anpai.Life、Smart Tab Pilot 与研发实践"
  description="One PC：以博客记录 Agent / OPC 研发过程，并以 Anpai.Life、Smart Tab Pilot、OPC Skills、AI Gateway 做产品展示。"
  altLocaleUrl="/en/"
  localeUrls={{ zh: "/", en: "/en/", ja: "/ja/" }}
  hreflangUrls={{
    zh: new URL("/", Astro.site).href,
    en: new URL("/en/", Astro.site).href,
    ja: new URL("/ja/", Astro.site).href
  }}
>
  <section class="page">
    <div class="hero-split">
      <div class="hero">
        <span class="eyebrow"><Icon name="sparkles" size={14} />开源 · 思考 · 服务</span>
        <h1>把想法做成产品，把经验写成文字</h1>
        <p class="lead">
          我是 One PC，一个独立开发者。这里收集开源项目、成体系的专栏、日常思考，
          以及可以直接用的 AI 服务。欢迎逛逛，也欢迎一起聊聊。
        </p>
        <div class="hero-actions">
          <a class="btn primary" href="/projects">看项目 <Icon name="arrow-right" size={16} /></a>
          <a class="btn ghost" href="/blog">读文章</a>
          <a class="btn ghost" href="/series">看专栏</a>
          <a class="btn ghost" href="/services">看服务</a>
        </div>
        <div class="hero-tags">
          <span class="tag">Astro</span>
          <span class="tag">AI / LLM</span>
          <span class="tag">基础设施</span>
          <span class="tag">独立开发</span>
        </div>
      </div>

      <aside class="hero-card">
        <p class="label">What I do</p>
        <h3>开源 + 写作 + 服务</h3>
        <p>用开源沉淀能力，用文章分享思考，用服务把能力变成可以直接用的东西。</p>
        <div class="hero-stats">
          <div class="stat"><strong>{featured.length}+</strong><span>精选项目</span></div>
          <div class="stat"><strong>{columns.length}</strong><span>门专栏</span></div>
          <div class="stat"><strong>{allPosts.length}</strong><span>篇文章</span></div>
          <div class="stat"><strong>{services.length}</strong><span>项服务</span></div>
        </div>
      </aside>
    </div>

    <div class="stack-vertical" style="margin-top:56px">
      <section>
        <div class="section-head">
          <h2>精选项目</h2>
          <p>我正在维护和打磨的开源项目，大多围绕 AI 和开发者效率。</p>
          <a class="more" href="/projects">查看全部项目 <Icon name="arrow-right" size={15} /></a>
        </div>
        <div class="grid cols-3">
          {featured.map((p) => <ProjectCard project={p} />)}
        </div>
      </section>

      <section>
        <div class="section-head">
          <h2>专栏</h2>
          <p>已经成体系的学习路径，按课程模块往下读。</p>
          <a class="more" href="/series">查看全部专栏 <Icon name="arrow-right" size={15} /></a>
        </div>
        <SeriesCards lang="zh" posts={allPosts} />
      </section>

      <section>
        <div class="section-head">
          <h2>最新文章</h2>
          <p>关于 AI 研发、独立开发和工程化的日常思考。</p>
          <a class="more" href="/blog">查看全部文章 <Icon name="arrow-right" size={15} /></a>
        </div>
        <div class="post-list">
          {latest.map((post) => (
            <a class="post-item" href={`/blog/${post.id}`}>
              <div class="date">{fmt(post.data.date)}</div>
              <h3>{post.data.title}</h3>
              <p class="excerpt">{post.data.excerpt}</p>
            </a>
          ))}
        </div>
      </section>

      <section>
        <div class="section-head">
          <h2>提供的服务</h2>
          <p>把下面这些能力直接拿来用，或者找我定制。</p>
          <a class="more" href="/services">查看全部服务 <Icon name="arrow-right" size={15} /></a>
        </div>
        <div class="grid cols-2">
          {topServices.map((s) => (
            <article class="card service-card">
              <div class="service-icon"><Icon name={s.icon} size={20} /></div>
              <h3>{s.name}</h3>
              <p class="summary">{s.summary}</p>
              <a
                class="btn ghost sm"
                href={s.cta.external ? s.cta.href : "/services"}
                target={s.cta.external ? "_blank" : undefined}
                rel={s.cta.external ? "noopener noreferrer" : undefined}
              >了解更多 <Icon name="arrow-up-right" size={14} /></a>
            </article>
          ))}
        </div>
      </section>

      <FriendsList />
    </div>
  </section>
</Base>
