---
import Base from "../../../../layouts/Base.astro";
import SeriesPage from "../../../../components/SeriesPage.astro";
import { getCollection } from "astro:content";
import { collectCurriculumSeries, collectSeries, seriesCurriculumSlots, seriesHref } from "../../../../lib/blog.js";

export async function getStaticPaths() {
  const all = await getCollection("blog");
  const en = all.filter((p) => p.data.lang === "en" && !p.data.draft);
  const zh = all.filter((p) => (p.data.lang ?? "zh") === "zh" && !p.data.draft);
  const zhSlugs = new Set(collectSeries(zh, { min: 1 }).map((s) => s.slug));
  const bySlug = new Map(collectCurriculumSeries(en, "en").map((s) => [s.slug, s]));
  for (const s of collectSeries(en, { min: 1 })) bySlug.set(s.slug, s);
  return [...bySlug.values()].map((series) => ({
    params: { slug: series.slug },
    props: { series, hasZh: zhSlugs.has(series.slug) }
  }));
}

const { series, hasZh } = Astro.props;
const slots = seriesCurriculumSlots(series.name);
const altLocaleUrl = hasZh ? seriesHref("zh", series.name) : "/blog/";
const localeUrls = {
  zh: hasZh ? seriesHref("zh", series.name) : "/blog/",
  en: seriesHref("en", series.name)
};
---
<Base
  title={series.name}
  description={
    slots
      ? `${series.name}: a ${slots}-lesson course grouped by module. ${series.count} lessons are in English.`
      : `${series.count} posts in the ${series.name} column, in reading order.`
  }
  altLocaleUrl={altLocaleUrl}
  localeUrls={localeUrls}
>
  <SeriesPage lang="en" series={series} />
</Base>
