---
import Base from "../../../layouts/Base.astro";
import ArticlePost from "../../../components/ArticlePost.astro";
import ArticleSeo from "../../../components/ArticleSeo.astro";
import { getCollection } from "astro:content";
import { blogHref, postSlug } from "../../../lib/i18n.js";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const en = posts.filter((p) => p.data.lang === "en" && !p.data.draft);
  const jaIds = new Set(
    posts.filter((p) => p.data.lang === "ja" && !p.data.draft).map((p) => postSlug(p.id))
  );
  return en.map((post) => {
    const slug = postSlug(post.id);
    return {
      params: { slug },
      props: { post, hasJa: jaIds.has(slug) }
    };
  });
}

const { post, hasJa } = Astro.props;
const slug = postSlug(post.id);
const localeUrls = {
  zh: blogHref("zh", slug),
  en: blogHref("en", slug),
  ja: hasJa ? blogHref("ja", slug) : undefined
};
---

<Base
  title={post.data.title}
  description={post.data.excerpt}
  type="article"
  image={post.data.ogImage}
  altLocaleUrl={blogHref("zh", slug)}
  localeUrls={localeUrls}
>
  <ArticleSeo slot="head" post={post} lang="en" hasEn hasJa={hasJa} />
  <ArticlePost post={post} lang="en" />
</Base>
