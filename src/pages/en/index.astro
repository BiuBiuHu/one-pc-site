---
import Base from "../../layouts/Base.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import SeriesCards from "../../components/SeriesCards.astro";
import FriendsList from "../../components/FriendsList.astro";
import Icon from "../../components/Icon.astro";
import { getFeaturedProjects } from "../../data/projects.en";
import { services } from "../../data/services.en";
import { getCollection } from "astro:content";
import { collectCurriculumSeries, seriesCopy, seriesHref } from "../../lib/blog.js";
import { blogHref, postSlug } from "../../lib/i18n.js";

const featured = getFeaturedProjects(4);
const allPosts = (await getCollection("blog"))
  .filter((p) => p.data.lang === "en" && !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const postsBySlug = new Map(allPosts.map((post) => [postSlug(post.id), post]));
const columns = collectCurriculumSeries(allPosts, "en");
const fullStack = columns.find((series) => series.slug === "full-stack-engineering");
const loop = postsBySlug.get("loop-engineering");
const locks = postsBySlug.get("optimistic-pessimistic-lock");

// Curated English entry points (recent GSC-impression URLs), not a recency sort.
const startHere = [
  loop && {
    href: blogHref("en", "loop-engineering"),
    label: "Loop Engineering",
    kicker: loop.data.category,
    title: loop.data.title,
    excerpt: loop.data.excerpt
  },
  locks && {
    href: blogHref("en", "optimistic-pessimistic-lock"),
    label: "Optimistic vs Pessimistic Locks",
    kicker: locks.data.series || locks.data.category,
    title: locks.data.title,
    excerpt: locks.data.excerpt
  },
  fullStack && {
    href: seriesHref("en", fullStack.name),
    label: fullStack.name,
    kicker: "Column",
    title: fullStack.name,
    excerpt: seriesCopy(fullStack.name, "en")
  },
  {
    href: "/en/projects/",
    label: "Projects",
    kicker: "Projects",
    title: "What I build",
    excerpt: "Open source projects I maintain around AI and developer productivity."
  }
].filter(Boolean);
const startHereHrefs = new Set(startHere.map((item) => item.href));
const latest = allPosts
  .filter((post) => !startHereHrefs.has(blogHref("en", postSlug(post.id))))
  .slice(0, 3);
const topServices = services.slice(0, 2);

const fmt = (d) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "2-digit", day: "2-digit" }).replace(/\//g, "-");
---
<Base
  title="Anpai.Life, Smart Tab Pilot, and research practice"
  description="One PC documents Agent and OPC research, and showcases products including Anpai.Life, Smart Tab Pilot, OPC Skills, and AI Gateway."
  altLocaleUrl="/"
  localeUrls={{ zh: "/", en: "/en/", ja: "/ja/" }}
  hreflangUrls={{
    zh: new URL("/", Astro.site).href,
    en: new URL("/en/", Astro.site).href,
    ja: new URL("/ja/", Astro.site).href
  }}
>
  <section class="page">
    <div class="hero-split">
      <div class="hero">
        <span class="eyebrow"><Icon name="sparkles" size={14} />Open source · Thoughts · Services</span>
        <h1>Turn ideas into products, turn experience into writing</h1>
        <p class="lead">
          I'm One PC, an independent developer. Here you'll find open source projects,
          structured columns, daily thoughts, and ready-to-use AI services. Feel free to explore and reach out.
        </p>
        <div class="hero-actions">
          <a class="btn primary" href="/en/projects/">See projects <Icon name="arrow-right" size={16} /></a>
          <a class="btn ghost" href="/en/blog/">Read posts</a>
          <a class="btn ghost" href="/en/series/">Browse columns</a>
          <a class="btn ghost" href="/en/services/">See services</a>
        </div>
        <div class="hero-tags">
          <span class="tag">Astro</span>
          <span class="tag">AI / LLM</span>
          <span class="tag">Infrastructure</span>
          <span class="tag">Indie dev</span>
        </div>
      </div>

      <aside class="hero-card">
        <p class="label">Start here</p>
        <h3>Featured English pages</h3>
        <p>A shorter path than the full archive: two posts, one column, and the project index.</p>
        <nav class="hero-start" aria-label="Featured English pages">
          {startHere.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </nav>
      </aside>
    </div>

    <div class="stack-vertical" style="margin-top:56px">
      <section id="start-here">
        <div class="section-head">
          <h2>Featured reading</h2>
          <p>English pages worth opening first — two posts, one column, and the project index.</p>
          <a class="more" href="/en/blog/">All English posts <Icon name="arrow-right" size={15} /></a>
        </div>
        <div class="post-list">
          {startHere.map((item) => (
            <a class="post-item" href={item.href}>
              <div class="date">{item.kicker}</div>
              <h3>{item.title}</h3>
              <p class="excerpt">{item.excerpt}</p>
            </a>
          ))}
        </div>
      </section>

      <section>
        <div class="section-head">
          <h2>Featured projects</h2>
          <p>Open source projects I maintain, mostly around AI and developer productivity.</p>
          <a class="more" href="/en/projects/">All projects <Icon name="arrow-right" size={15} /></a>
        </div>
        <div class="grid cols-3">
          {featured.map((p) => <ProjectCard project={p} />)}
        </div>
      </section>

      <section>
        <div class="section-head">
          <h2>Columns</h2>
          <p>Structured columns, grouped by theme — not another post list.</p>
          <a class="more" href="/en/series/">All columns <Icon name="arrow-right" size={15} /></a>
        </div>
        <SeriesCards lang="en" posts={allPosts} />
      </section>

      <section>
        <div class="section-head">
          <h2>Latest posts</h2>
          <p>Thoughts on AI development, indie dev, and engineering.</p>
          <a class="more" href="/en/blog/">All posts <Icon name="arrow-right" size={15} /></a>
        </div>
        <div class="post-list">
          {latest.map((post) => (
            <a class="post-item" href={blogHref("en", postSlug(post.id))}>
              <div class="date">{fmt(post.data.date)}</div>
              <h3>{post.data.title}</h3>
              <p class="excerpt">{post.data.excerpt}</p>
            </a>
          ))}
        </div>
      </section>

      <section>
        <div class="section-head">
          <h2>Services</h2>
          <p>Use these capabilities directly, or ask for something custom.</p>
          <a class="more" href="/en/services/">All services <Icon name="arrow-right" size={15} /></a>
        </div>
        <div class="grid cols-2">
          {topServices.map((s) => (
            <article class="card service-card">
              <div class="service-icon"><Icon name={s.icon} size={20} /></div>
              <h3>{s.name}</h3>
              <p class="summary">{s.summary}</p>
              <a
                class="btn ghost sm"
                href={s.cta.external ? s.cta.href : "/en/services/"}
                target={s.cta.external ? "_blank" : undefined}
                rel={s.cta.external ? "noopener noreferrer" : undefined}
              >Learn more <Icon name="arrow-up-right" size={14} /></a>
            </article>
          ))}
        </div>
      </section>

      <FriendsList />
    </div>
  </section>
</Base>
