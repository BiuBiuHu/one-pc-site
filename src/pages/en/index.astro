---
import Base from "../../layouts/Base.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import Icon from "../../components/Icon.astro";
import { getFeaturedProjects } from "../../data/projects.en";
import { services } from "../../data/services.en";
import { getCollection } from "astro:content";

const featured = getFeaturedProjects(3);
const allPosts = (await getCollection("blog"))
  .filter((p) => p.data.lang === "en")
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const latest = allPosts.slice(0, 3);
const topServices = services.slice(0, 2);

const fmt = (d) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "2-digit", day: "2-digit" }).replace(/\//g, "-");
---
<Base altLocaleUrl="/">
  <section class="page">
    <div class="hero-split">
      <div class="hero">
        <span class="eyebrow"><Icon name="sparkles" size={14} />Open source · Thoughts · Services</span>
        <h1>Turn ideas into products, turn experience into writing</h1>
        <p class="lead">
          I'm One PC, an independent developer. Here you'll find my open source projects,
          daily thoughts, and ready-to-use services — email, AI, and more. Feel free to explore and reach out.
        </p>
        <div class="hero-actions">
          <a class="btn primary" href="/en/projects">See projects <Icon name="arrow-right" size={16} /></a>
          <a class="btn ghost" href="/en/blog">Read posts</a>
          <a class="btn ghost" href="/en/services">See services</a>
        </div>
        <div class="hero-tags">
          <span class="tag">Astro</span>
          <span class="tag">AI / LLM</span>
          <span class="tag">Infrastructure</span>
          <span class="tag">Indie dev</span>
        </div>
      </div>

      <aside class="hero-card">
        <p class="label">What I do</p>
        <h3>Open source + Writing + Services</h3>
        <p>Build capabilities through open source, share thinking through writing, turn capabilities into usable services.</p>
        <div class="hero-stats">
          <div class="stat"><strong>{featured.length}+</strong><span>Featured</span></div>
          <div class="stat"><strong>{allPosts.length}</strong><span>Posts</span></div>
          <div class="stat"><strong>{services.length}</strong><span>Services</span></div>
        </div>
      </aside>
    </div>

    <div class="stack-vertical" style="margin-top:56px">
      <section>
        <div class="section-head">
          <h2>Featured projects</h2>
          <p>Open source projects I maintain, mostly around AI and developer productivity.</p>
          <a class="more" href="/en/projects">All projects <Icon name="arrow-right" size={15} /></a>
        </div>
        <div class="grid cols-3">
          {featured.map((p) => <ProjectCard project={p} />)}
        </div>
      </section>

      <section>
        <div class="section-head">
          <h2>Latest posts</h2>
          <p>Thoughts on AI development, indie dev, and engineering.</p>
          <a class="more" href="/en/blog">All posts <Icon name="arrow-right" size={15} /></a>
        </div>
        <div class="post-list">
          {latest.map((post) => (
            <a class="post-item" href={`/en/blog/${post.id.replace(/-en$/, "")}`}>
              <div class="date">{fmt(post.data.date)}</div>
              <h3>{post.data.title}</h3>
              <p class="excerpt">{post.data.excerpt}</p>
            </a>
          ))}
        </div>
      </section>

      <section>
        <div class="section-head">
          <h2>Services</h2>
          <p>Use these capabilities directly, or ask for something custom.</p>
          <a class="more" href="/en/services">All services <Icon name="arrow-right" size={15} /></a>
        </div>
        <div class="grid cols-2">
          {topServices.map((s) => (
            <article class="card service-card">
              <div class="service-icon"><Icon name={s.icon} size={20} /></div>
              <h3>{s.name}</h3>
              <p class="summary">{s.summary}</p>
              <a
                class="btn ghost sm"
                href={s.cta.external ? s.cta.href : "/en/services"}
                target={s.cta.external ? "_blank" : undefined}
                rel={s.cta.external ? "noopener noreferrer" : undefined}
              >Learn more <Icon name="arrow-up-right" size={14} /></a>
            </article>
          ))}
        </div>
      </section>
    </div>
  </section>
</Base>
