---
import "../styles/global.css";
import { site, personNode } from "../data/site";
import Icon from "../components/Icon.astro";
import Analytics from "@vercel/analytics/astro";
import LocaleLinks from "../components/LocaleLinks.astro";
import { HREFLANG, HTML_LANG, LOCALE_LABEL, homeHref, inLanguageOf, normalizeLocale } from "../lib/i18n.js";

const { title, description, type = "website", image, altLocaleUrl, robots, hreflangUrls, localeUrls } = Astro.props;
const locale = normalizeLocale(Astro.currentLocale);
const isEn = locale === "en";
const isJa = locale === "ja";
const path = Astro.url.pathname;
const siteLabel = isEn ? "Personal Site" : isJa ? "個人サイト" : "个人站点";
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · ${siteLabel}`;
const desc =
  description ||
  (isEn
    ? "One PC — open source projects, daily thoughts, and ready-to-use services."
    : isJa
      ? "One PC — Agent / Skills / OPC の実践。日本語は需要の高いページから公開しています。"
      : "One PC 的个人站点 —— 开源项目、日常思考，以及邮件、AI 等可直接使用的服务。");
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
if (!canonicalUrl.pathname.endsWith("/")) canonicalUrl.pathname += "/";
const canonical = canonicalUrl.href;
const ogImage = new URL(image || site.ogImage, Astro.site).href;
const isHome = path === "/" || path === "/en" || path === "/en/" || path === "/ja" || path === "/ja/";
const altAbs = altLocaleUrl ? new URL(altLocaleUrl, Astro.site).href : null;
const websiteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: site.name,
  url: new URL(isJa ? "/ja/" : isEn ? "/en/" : "/", Astro.site).href,
  description: desc,
  inLanguage: inLanguageOf(locale),
  publisher: personNode({ url: new URL("/", Astro.site).href })
};

const pathKey = path.replace(/^\/(en|ja)(?=\/|$)/, "").replace(/\/+$/, "") || "/";
const NAV = isEn
  ? [
      { href: "/", label: "Home", match: (p) => p === "/" },
      { href: "/en/projects", label: "Projects", match: (p) => p.startsWith("/projects") },
      { href: "/en/blog", label: "Blog", match: (p) => p.startsWith("/blog") },
      { href: "/en/services", label: "Services", match: (p) => p.startsWith("/services") },
      { href: "/en/about", label: "About", match: (p) => p.startsWith("/about") }
    ]
  : isJa
    ? [
        { href: "/ja/", label: "ホーム", match: (p) => p === "/" },
        { href: "/ja/blog/", label: "記事", match: (p) => p.startsWith("/blog") },
        { href: "/ja/projects/opc-skills/", label: "OPC Skills", match: (p) => p.startsWith("/projects") }
      ]
    : [
        { href: "/", label: "首页", match: (p) => p === "/" },
        { href: "/projects", label: "项目", match: (p) => p.startsWith("/projects") },
        { href: "/blog", label: "博客", match: (p) => p.startsWith("/blog") },
        { href: "/services", label: "服务", match: (p) => p.startsWith("/services") },
        { href: "/about", label: "关于", match: (p) => p.startsWith("/about") }
      ];

const switchHref = altLocaleUrl || (isEn ? "/" : isJa ? "/" : "/en/blog/");
const switchers = localeUrls
  ? Object.entries(localeUrls)
      .filter(([key, href]) => href && key !== locale)
      .map(([key, href]) => ({ lang: key, href, label: LOCALE_LABEL[key] }))
  : [{ lang: isEn || isJa ? "zh" : "en", href: switchHref, label: isEn || isJa ? "中文" : "English" }];
const localeUrlMap = localeUrls
  ? Object.fromEntries(Object.entries(localeUrls).filter(([, href]) => href))
  : null;
const year = new Date().getFullYear();
const gaId = import.meta.env.PUBLIC_GA_ID;
const brandHref = homeHref(locale);
// JA 没有独立 feed（/ja/rss.xml 404），可见入口与 head alternate 一并隐藏，避免点到英文/中文源。
const rssHref = isJa ? "" : isEn ? "/en/rss.xml" : "/rss.xml";
const rssLabel = isEn ? "Blog RSS" : "博客 RSS";
const ogAlternates = Object.entries(HREFLANG)
  .filter(([key]) => key !== locale)
  .map(([, value]) => value);
---
<!doctype html>
<html
  lang={HTML_LANG[locale]}
  data-lang={locale}
  data-alt-url={switchHref || ""}
  data-locale-urls={localeUrlMap ? JSON.stringify(localeUrlMap) : undefined}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    {robots && <meta name="robots" content={robots} />}
    <meta name="theme-color" content="#4f46e5" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={HREFLANG[locale]} />
    {ogAlternates.map((code) => <meta property="og:locale:alternate" content={code} />)}
    <link rel="canonical" href={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={desc} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:image" content={ogImage} />
    {
      type !== "article" && !robots && hreflangUrls && (
        <LocaleLinks urls={hreflangUrls} />
      )
    }
    {
      type !== "article" && !robots && !hreflangUrls && altAbs && (
        <>
          <link rel="alternate" hreflang={HREFLANG[locale]} href={canonical} />
          <link rel="alternate" hreflang={isEn ? "zh-CN" : "en-US"} href={altAbs} />
          <link rel="alternate" hreflang="x-default" href={isEn || isJa ? altAbs : canonical} />
        </>
      )
    }
    {isHome && <script type="application/ld+json" set:html={JSON.stringify(websiteLd)} />}
    {rssHref && <link rel="alternate" type="application/rss+xml" title={`${site.name} · ${rssLabel}`} href={rssHref} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // 语言分流：优先用户手动选择（lang-pref），否则按浏览器语言；爬虫跳过
      (function () {
        var root = document.documentElement;
        var cur = root.getAttribute("data-lang");
        var alt = root.getAttribute("data-alt-url");
        var map = null;
        try { map = JSON.parse(root.getAttribute("data-locale-urls") || "null"); } catch (e) {}
        var ua = navigator.userAgent.toLowerCase();
        if (/bot|crawler|spider|slurp|bing|baiduspider/i.test(ua)) return;
        var pref = null;
        try { pref = localStorage.getItem("lang-pref"); } catch (e) {}
        var target;
        if (pref === "zh" || pref === "en" || pref === "ja") {
          target = pref;
        } else if (cur === "ja") {
          return;
        } else {
          var lang = (navigator.language || navigator.userLanguage || "").toLowerCase();
          target = lang.indexOf("en") === 0 ? "en" : "zh";
        }
        if (target === cur) return;
        var dest = (map && map[target]) || (target === "ja" ? "" : alt);
        if (dest) location.replace(dest);
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <div class="site">
      <header class="topbar">
        <div class="container nav">
          <a class="brand" href={brandHref}>
            <span class="brand-mark">OP</span>
            <span>{site.name}</span>
          </a>
          <nav class="menu">
            {NAV.map((item) => (
              <a href={item.href} aria-current={item.match(pathKey) ? "page" : undefined}>
                {item.label}
              </a>
            ))}
          </nav>
          <div class="nav-actions">
            {switchers.map((item) => (
              <a class="lang-switch" href={item.href} data-lang={item.lang}>{item.label}</a>
            ))}
            <a class="icon-link" href={site.githubUrl} target="_blank" rel="noreferrer" aria-label="GitHub" title={site.githubUrl}>
              <Icon name="github" size={18} />
            </a>
            {rssHref && (
              <a class="icon-link" href={rssHref} aria-label={rssLabel} title={rssLabel}>
                <Icon name="rss" size={18} />
              </a>
            )}
            <a class="icon-link" href={`mailto:${site.email}`} aria-label="邮箱" title={site.email}>
              <Icon name="mail" size={18} />
            </a>
          </div>
        </div>
      </header>

      <main class="main container">
        <slot />
      </main>

      <footer class="footer">
        <div class="container footer-inner">
          <div class="footer-brand">
            <span class="brand-mark">OP</span>
            <span>{site.name} · {siteLabel}</span>
          </div>
          <div class="footer-links">
            {isJa ? (
              <>
                <a href="/ja/">ホーム</a>
                <a href="/ja/blog/">記事</a>
                <a href="/ja/projects/opc-skills/">OPC Skills</a>
              </>
            ) : (
              <>
                <a href={isEn ? "/en/about" : "/about"}>{isEn ? "About" : "关于"}</a>
                <a href={isEn ? "/en/projects" : "/projects"}>{isEn ? "Projects" : "项目"}</a>
                <a href={isEn ? "/en/blog" : "/blog"}>{isEn ? "Blog" : "博客"}</a>
                <a href={isEn ? "/en/services" : "/services"}>{isEn ? "Services" : "服务"}</a>
              </>
            )}
            <a href={site.githubUrl} target="_blank" rel="noreferrer">GitHub</a>
            {rssHref && <a href={rssHref}>RSS</a>}
            <a href={`mailto:${site.email}`}>{isEn ? "Contact · " : isJa ? "連絡 · " : "联系我 · "}{site.email}</a>
          </div>
          <div>© {year} {site.name}</div>
        </div>
      </footer>
    </div>

    <script is:inline>
      // 项目 star 数：HTML 已是构建期 GitHub 实数；这里再拉一次，部署后新增的 star 也能跟上
      (function () {
        var nodes = document.querySelectorAll(".stars[data-repo]");
        if (!nodes.length) return;
        var repos = Array.from(new Set(Array.prototype.map.call(nodes, function (n) {
          return n.getAttribute("data-repo");
        })));
        repos.forEach(function (repo) {
          fetch("https://api.github.com/repos/" + repo)
            .then(function (r) { return r.ok ? r.json() : Promise.reject(r.status); })
            .then(function (d) {
              if (typeof d.stargazers_count !== "number") return;
              var cnt = d.stargazers_count;
              document.querySelectorAll('.stars[data-repo="' + repo + '"] .star-count').forEach(function (el) {
                el.textContent = cnt;
              });
            })
            .catch(function () { /* 拉取失败保留静态占位值，不打扰用户 */ });
        });
      })();
    </script>

    <script is:inline>
      // 语言切换：记录用户手动选择，后续分流尊重此偏好
      (function () {
        document.querySelectorAll(".lang-switch").forEach(function (a) {
          a.addEventListener("click", function () {
            var lang = a.getAttribute("data-lang");
            if (!lang) return;
            try { localStorage.setItem("lang-pref", lang); } catch (e) {}
          });
        });
      })();
    </script>

    {import.meta.env.PUBLIC_HOSTING_PROVIDER !== "cloudflare" && <Analytics />}

    {
      /* Google Analytics 4：空闲时异步加载，零阻塞首屏（未配 PUBLIC_GA_ID 时不注入） */
      gaId && (
        <script
          is:inline
          data-ga-id={gaId}
        >
          (function () {
            var GA_ID = document.currentScript.getAttribute("data-ga-id");
            if (!GA_ID) return;
            var load = function () {
              var s = document.createElement("script");
              s.src = "https://www.googletagmanager.com/gtag/js?id=" + GA_ID;
              s.async = true;
              document.head.appendChild(s);
              window.dataLayer = window.dataLayer || [];
              window.gtag = function () { window.dataLayer.push(arguments); };
              window.gtag("js", new Date());
              window.gtag("config", GA_ID, { send_page_view: true });
            };
            // 优先空闲时加载，兼容旧浏览器降级为 setTimeout
            if ("requestIdleCallback" in window) {
              window.requestIdleCallback(load, { timeout: 2000 });
            } else {
              setTimeout(load, 2000);
            }
          })();
        </script>
      )
    }
  </body>
</html>
