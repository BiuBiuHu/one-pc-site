---
import "../styles/global.css";
import { site } from "../data/site";
import Icon from "../components/Icon.astro";
import Analytics from "@vercel/analytics/astro";

const { title, description } = Astro.props;
const path = Astro.url.pathname;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · 个人站点`;
const desc =
  description || "One PC 的个人站点 —— 开源项目、日常思考，以及邮件、AI 等可直接使用的服务。";

const NAV = [
  { href: "/", label: "首页", match: (p) => p === "/" },
  { href: "/projects", label: "项目", match: (p) => p.startsWith("/projects") },
  { href: "/blog", label: "博客", match: (p) => p.startsWith("/blog") },
  { href: "/services", label: "服务", match: (p) => p.startsWith("/services") },
  { href: "/write", label: "写作", match: (p) => p.startsWith("/write") }
];
const year = new Date().getFullYear();
// GA4 Measurement ID：从环境变量读取（Vercel 配 PUBLIC_GA_ID），未配置则不注入
const gaId = import.meta.env.PUBLIC_GA_ID;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <meta name="theme-color" content="#4f46e5" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <div class="site">
      <header class="topbar">
        <div class="container nav">
          <a class="brand" href="/">
            <span class="brand-mark">OP</span>
            <span>{site.name}</span>
          </a>
          <nav class="menu">
            {NAV.map((item) => (
              <a href={item.href} aria-current={item.match(path) ? "page" : undefined}>
                {item.label}
              </a>
            ))}
          </nav>
          <div class="nav-actions">
            <a class="icon-link" href={site.githubUrl} target="_blank" rel="noreferrer" aria-label="GitHub" title={site.githubUrl}>
              <Icon name="github" size={18} />
            </a>
            <a class="icon-link" href={`mailto:${site.email}`} aria-label="邮箱" title={site.email}>
              <Icon name="mail" size={18} />
            </a>
          </div>
        </div>
      </header>

      <main class="main container">
        <slot />
      </main>

      <footer class="footer">
        <div class="container footer-inner">
          <div class="footer-brand">
            <span class="brand-mark">OP</span>
            <span>{site.name} · 个人站点</span>
          </div>
          <div class="footer-links">
            <a href="/projects">项目</a>
            <a href="/blog">博客</a>
            <a href="/services">服务</a>
            <a href="/write">写作</a>
            <a href={site.githubUrl} target="_blank" rel="noreferrer">GitHub</a>
            <a href={`mailto:${site.email}`}>联系我 · {site.email}</a>
          </div>
          <div>© {year} {site.name}</div>
        </div>
      </footer>
    </div>

    <script is:inline>
      // 项目 star 数同步：静态数字仅作占位，运行时调 GitHub API 拉真实值并刷新
      (function () {
        var nodes = document.querySelectorAll(".stars[data-repo]");
        if (!nodes.length) return;
        var repos = Array.from(new Set(Array.prototype.map.call(nodes, function (n) {
          return n.getAttribute("data-repo");
        })));
        repos.forEach(function (repo) {
          fetch("https://api.github.com/repos/" + repo)
            .then(function (r) { return r.ok ? r.json() : Promise.reject(r.status); })
            .then(function (d) {
              if (typeof d.stargazers_count !== "number") return;
              var cnt = d.stargazers_count;
              document.querySelectorAll('.stars[data-repo="' + repo + '"] .star-count').forEach(function (el) {
                el.textContent = cnt;
              });
            })
            .catch(function () { /* 拉取失败保留静态占位值，不打扰用户 */ });
        });
      })();
    </script>

    <Analytics />

    {
      /* Google Analytics 4：空闲时异步加载，零阻塞首屏（未配 PUBLIC_GA_ID 时不注入） */
      gaId && (
        <script
          is:inline
          data-ga-id={gaId}
        >
          (function () {
            var GA_ID = document.currentScript.getAttribute("data-ga-id");
            if (!GA_ID) return;
            var load = function () {
              var s = document.createElement("script");
              s.src = "https://www.googletagmanager.com/gtag/js?id=" + GA_ID;
              s.async = true;
              document.head.appendChild(s);
              window.dataLayer = window.dataLayer || [];
              window.gtag = function () { window.dataLayer.push(arguments); };
              window.gtag("js", new Date());
              window.gtag("config", GA_ID, { send_page_view: true });
            };
            // 优先空闲时加载，兼容旧浏览器降级为 setTimeout
            if ("requestIdleCallback" in window) {
              window.requestIdleCallback(load, { timeout: 2000 });
            } else {
              setTimeout(load, 2000);
            }
          })();
        </script>
      )
    }
  </body>
</html>
