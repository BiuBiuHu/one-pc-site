---
import Icon from "./Icon.astro";
import {
  collectCurriculumSeries,
  groupSeriesCurriculum,
  seriesCopy,
  seriesCurriculumSlots,
  seriesHref
} from "../lib/blog.js";
import { blogHref, postSlug } from "../lib/i18n.js";

interface Props {
  lang: "zh" | "en";
  posts: any[];
}

const { lang, posts } = Astro.props;
const isEn = lang === "en";
/** 55-article column stays group-only on the card; the three shorter columns list posts. */
const CARD_ARTICLE_SLUGS = new Set([
  "agent-development",
  "full-stack-engineering",
  "webview-and-native"
]);
const seriesList = collectCurriculumSeries(posts, lang).map((series) => {
  const grouped = groupSeriesCurriculum(series.posts, series.name, lang) || [];
  const listArticles = CARD_ARTICLE_SLUGS.has(series.slug);
  return {
    ...series,
    blurb: seriesCopy(series.name, lang),
    slots: seriesCurriculumSlots(series.name),
    modules: grouped.map((mod) => ({
      id: mod.id,
      title: mod.title,
      posts: listArticles
        ? mod.posts.map((post) => ({
            title: post.data.title,
            href: blogHref(lang, postSlug(post.id))
          }))
        : []
    })),
    href: seriesHref(lang, series.name)
  };
});
const ui = isEn
  ? {
      kicker: (slots, count, mods) =>
        count === 0
          ? `${slots} articles · Chinese only · ${mods} groups`
          : count < slots
            ? `${slots} articles · ${count} in English · ${mods} groups`
            : `${slots} articles · ${mods} groups`,
      cta: "Open the column"
    }
  : {
      kicker: (slots, count, mods) =>
        count < slots ? `${slots} 篇 · 已有 ${count} 篇 · ${mods} 个分组` : `${slots} 篇 · ${mods} 个分组`,
      cta: "进入专栏"
    };
---
<div class="grid cols-2">
  {seriesList.map((series) => (
    <article class="card hover series-index-card">
      <p class="series-index-kicker">{ui.kicker(series.slots, series.count, series.modules.length)}</p>
      <h2>
        <a href={series.href}>{series.name}</a>
      </h2>
      <p class="desc">{series.blurb}</p>
      <ol class="series-index-modules">
        {series.modules.map((mod, i) => (
          <li>
            <a class="series-index-mod" href={`${series.href}#${mod.id}`}>
              <span class="series-index-mod-n">{String(i + 1).padStart(2, "0")}</span>
              {mod.title}
            </a>
            {mod.posts.length > 0 && (
              <ol class="series-index-articles">
                {mod.posts.map((post) => (
                  <li>
                    <a href={post.href}>{post.title}</a>
                  </li>
                ))}
              </ol>
            )}
          </li>
        ))}
      </ol>
      <a class="more" href={series.href}>
        {ui.cta} <Icon name="arrow-right" size={15} />
      </a>
    </article>
  ))}
</div>
