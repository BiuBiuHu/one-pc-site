---
import Icon from "./Icon.astro";
import {
  collectCurriculumSeries,
  seriesCopy,
  seriesCurriculum,
  seriesCurriculumSlots,
  seriesHref
} from "../lib/blog.js";

interface Props {
  lang: "zh" | "en";
  posts: any[];
}

const { lang, posts } = Astro.props;
const isEn = lang === "en";
const locale = isEn ? "en" : "zh";
const seriesList = collectCurriculumSeries(posts).map((series) => {
  const modules = seriesCurriculum(series.name) || [];
  return {
    ...series,
    blurb: seriesCopy(series.name, lang),
    slots: seriesCurriculumSlots(series.name),
    modules: modules.map((mod) => mod.title[locale] || mod.title.zh),
    href: seriesHref(lang, series.name)
  };
});
const ui = isEn
  ? {
      kicker: (slots, count, mods) =>
        count < slots
          ? `${slots} lessons · ${count} in English · ${mods} modules`
          : `${slots} lessons · ${mods} modules`,
      cta: "Enter the course"
    }
  : {
      kicker: (slots, count, mods) =>
        count < slots ? `${slots} 课 · 已有 ${count} 篇 · ${mods} 个模块` : `${slots} 课 · ${mods} 个模块`,
      cta: "进入课程"
    };
---
<div class="grid cols-2">
  {seriesList.map((series) => (
    <article class="card hover series-index-card">
      <p class="series-index-kicker">{ui.kicker(series.slots, series.count, series.modules.length)}</p>
      <h2>
        <a href={series.href}>{series.name}</a>
      </h2>
      <p class="desc">{series.blurb}</p>
      <ol class="series-index-modules">
        {series.modules.map((title, i) => (
          <li>
            <span class="series-index-mod-n">{String(i + 1).padStart(2, "0")}</span>
            {title}
          </li>
        ))}
      </ol>
      <a class="more" href={series.href}>
        {ui.cta} <Icon name="arrow-right" size={15} />
      </a>
    </article>
  ))}
</div>
