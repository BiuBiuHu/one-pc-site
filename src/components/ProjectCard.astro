---
import Icon from "./Icon.astro";
import { githubRepoSlug } from "../lib/github-stars";
const { project } = Astro.props;
const isEn = Astro.currentLocale === "en";
const isWip = project.status === "wip";
// 区分「开源仓库」（有 GitHub repo，显示 star、跳仓库）与「产品官网」（只有 homepage，跳官网）
const repoFull = githubRepoSlug(project.repo);
const isRepo = !!repoFull;
const linkHref = isRepo ? project.repo : project.homepage || "#";
const linkIcon = isRepo ? "github" : "external-link";
const linkLabel = isRepo ? (isEn ? "Repository" : "仓库") : (isEn ? "Visit" : "访问");
const statusText = isEn ? (isWip ? "In progress" : "Maintained") : (isWip ? "开发中" : "维护中");
---
<article class="card hover project-card">
  <div class="project-top">
    <span class="lang">
      <span class="dot" style={`background:${project.languageColor}`}></span>
      {project.language}
    </span>
    {isRepo && (
      <span class="stars" data-repo={repoFull}><Icon name="star" size={13} /><span class="star-count">{project.stars}</span></span>
    )}
  </div>

  <h3>{project.name}</h3>
  <p class="tagline">{project.tagline}</p>
  <p class="desc">{project.description}</p>

  <div class="project-tags">
    {project.tags.map((t) => <span class="tag">{t}</span>)}
  </div>

  <div class="project-footer">
    <span class={`status ${isWip ? "wip" : ""}`}>
      <span class="pulse"></span>
      {statusText}
    </span>
    <a class="repo-link" href={linkHref} target="_blank" rel="noreferrer">
      <Icon name={linkIcon} size={14} />
      {linkLabel}
    </a>
  </div>
</article>
