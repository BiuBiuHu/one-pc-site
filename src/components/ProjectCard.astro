---
import Icon from "./Icon.astro";
import { githubRepoSlug } from "../lib/github-stars";
import { hubPathForProject } from "../data/product-hubs";
import { projectHomepageHref } from "../lib/project-links";
import { normalizeLocale } from "../lib/i18n.js";
const { project } = Astro.props;
const locale = normalizeLocale(Astro.currentLocale);
const isEn = locale === "en";
const isWip = project.status === "wip";
const hubHref = hubPathForProject(project.name, locale);
const repoFull = githubRepoSlug(project.repo);
const isRepo = !!repoFull;
const homepageHref = projectHomepageHref(project, locale);
const webAppHref = project.webApp || "";
const storeHref = project.store
  ? isEn
    ? project.store
    : `${project.store}${project.store.includes("?") ? "&" : "?"}hl=zh-CN`
  : "";
// 标题：独立介绍页优先，否则官网，再否则仓库
const titleHref = hubHref || homepageHref || (isRepo ? project.repo : "#");
const titleExternal = !hubHref;
const actions = [];
if (hubHref) {
  actions.push({
    href: hubHref,
    label: isEn ? "Learn more" : "了解更多",
    icon: "arrow-right",
    external: false,
    aria: isEn ? `Learn more about ${project.name}` : `了解 ${project.name}`
  });
}
if (homepageHref) {
  const onlyHome = !hubHref && !webAppHref && !storeHref && !isRepo;
  actions.push({
    href: homepageHref,
    label: onlyHome ? (isEn ? "Visit" : "访问") : isEn ? "Website" : "官网",
    icon: "external-link",
    external: true,
    aria: isEn ? `${project.name} official website` : `${project.name} 官网`
  });
}
if (webAppHref) {
  actions.push({
    href: webAppHref,
    label: isEn ? "Web app" : "Web 端",
    icon: "external-link",
    external: true,
    aria: isEn ? `${project.name} web app` : `${project.name} Web 端`
  });
}
if (storeHref) {
  actions.push({
    href: storeHref,
    label: isEn ? "Chrome Web Store" : "Chrome 商店",
    icon: "external-link",
    external: true,
    aria: isEn ? `Install ${project.name} from the Chrome Web Store` : `从 Chrome 商店安装 ${project.name}`
  });
}
if (isRepo) {
  actions.push({
    href: project.repo,
    label: isEn ? "GitHub" : "GitHub",
    icon: "github",
    external: true,
    aria: isEn ? `${project.name} GitHub repository` : `${project.name} GitHub 仓库`
  });
}
const statusText = isEn ? (isWip ? "In progress" : "Maintained") : (isWip ? "开发中" : "维护中");
---
<article class="card hover project-card">
  <div class="project-top">
    <span class="lang">
      <span class="dot" style={`background:${project.languageColor}`}></span>
      {project.language}
    </span>
    {isRepo && (
      <span class="stars" data-repo={repoFull}><Icon name="star" size={13} /><span class="star-count">{project.stars}</span></span>
    )}
  </div>

  <h3>
    <a
      href={titleHref}
      target={titleExternal ? "_blank" : undefined}
      rel={titleExternal ? "noopener noreferrer" : undefined}
    >{project.name}</a>
  </h3>
  <p class="tagline">{project.tagline}</p>
  <p class="desc">{project.description}</p>

  <div class="project-tags">
    {project.tags.map((t) => <span class="tag">{t}</span>)}
  </div>

  <div class="project-footer">
    <span class={`status ${isWip ? "wip" : ""}`}>
      <span class="pulse"></span>
      {statusText}
    </span>
    <div class="project-actions">
      {actions.map((action) => (
        <a
          class="repo-link"
          href={action.href}
          target={action.external ? "_blank" : undefined}
          rel={action.external ? "noopener noreferrer" : undefined}
          aria-label={action.aria}
        >
          <Icon name={action.icon} size={14} />
          {action.label}
        </a>
      ))}
    </div>
  </div>
</article>
