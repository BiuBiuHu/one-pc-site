---
import Icon from "./Icon.astro";
import { githubRepoSlug } from "../lib/github-stars";
import { hubPathForProject } from "../data/product-hubs";
const { project } = Astro.props;
const isEn = Astro.currentLocale === "en";
const isWip = project.status === "wip";
const hubHref = hubPathForProject(project.name, isEn);
// 有独立入口页时标题和页脚进 hub；其余仍区分仓库 / 官网
const repoFull = githubRepoSlug(project.repo);
const isRepo = !!repoFull;
const linkHref = hubHref || (isRepo ? project.repo : project.homepage || "#");
const linkIcon = hubHref ? "arrow-right" : isRepo ? "github" : "external-link";
const linkLabel = hubHref
  ? isEn
    ? "Learn more"
    : "了解更多"
  : isRepo
    ? isEn
      ? "Repository"
      : "仓库"
    : isEn
      ? "Visit"
      : "访问";
const linkExternal = !hubHref;
const statusText = isEn ? (isWip ? "In progress" : "Maintained") : (isWip ? "开发中" : "维护中");
---
<article class="card hover project-card">
  <div class="project-top">
    <span class="lang">
      <span class="dot" style={`background:${project.languageColor}`}></span>
      {project.language}
    </span>
    {isRepo && (
      <span class="stars" data-repo={repoFull}><Icon name="star" size={13} /><span class="star-count">{project.stars}</span></span>
    )}
  </div>

  <h3>{hubHref ? <a href={hubHref}>{project.name}</a> : project.name}</h3>
  <p class="tagline">{project.tagline}</p>
  <p class="desc">{project.description}</p>

  <div class="project-tags">
    {project.tags.map((t) => <span class="tag">{t}</span>)}
  </div>

  <div class="project-footer">
    <span class={`status ${isWip ? "wip" : ""}`}>
      <span class="pulse"></span>
      {statusText}
    </span>
    <a
      class="repo-link"
      href={linkHref}
      target={linkExternal ? "_blank" : undefined}
      rel={linkExternal ? "noreferrer" : undefined}
    >
      <Icon name={linkIcon} size={14} />
      {linkLabel}
    </a>
  </div>
</article>
