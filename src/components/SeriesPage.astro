---
import Icon from "./Icon.astro";
import ArchiveCard from "./ArchiveCard.astro";
import { groupSeriesCurriculum, seriesCurriculumSlots, seriesIndexHref, seriesArticleLabel } from "../lib/blog.js";
import { DATE_LOCALE, postSlug, blogHref } from "../lib/i18n.js";

interface Props {
  lang: "zh" | "en";
  series: {
    name: string;
    count: number;
    posts: any[];
  };
}

const { lang, series } = Astro.props;
const isEn = lang === "en";
const fmt = (d) =>
  d.toLocaleDateString(DATE_LOCALE[lang], { year: "numeric", month: "2-digit", day: "2-digit" }).replace(/\//g, "-");
const total = series.count;
const modules = groupSeriesCurriculum(series.posts, series.name, lang);
const slots = seriesCurriculumSlots(series.name);
const ui = isEn
  ? {
      back: "Back to columns",
      eyebrow: "Column",
      blurb: modules
        ? total === 0
          ? `${slots} articles grouped by theme. Published in Chinese; English versions are not available yet.`
          : total < slots
            ? `${slots} articles grouped by theme. ${total} are in English.`
            : `${slots} articles grouped by theme.`
        : `${total} articles in reading order.`,
      module: (n) => `Group ${String(n).padStart(2, "0")}`,
      empty: "Chinese articles in this group are published; English versions are not available yet.",
      part: (n) => `Article ${n} of ${total}`,
      jump: "Jump to group"
    }
  : {
      back: "返回专栏",
      eyebrow: "专栏",
      blurb: modules ? `按主题分组，共 ${slots} 篇。` : `按阅读顺序排列，共 ${total} 篇。`,
      module: (n) => `分组 ${String(n).padStart(2, "0")}`,
      empty: "此分组的中文文章已发布，英译尚未推出。",
      part: (n) => `第 ${n} / ${total} 篇`,
      jump: "跳到分组"
    };

const articleOf = (post) =>
  seriesArticleLabel(series.name, post.data.seriesOrder, lang) || undefined;
---
<section class="page series-page">
  <a class="back-link" href={seriesIndexHref(lang)}>
    <Icon name="arrow-left" size={15} />{ui.back}
  </a>
  <div class="section-head">
    <span class="eyebrow"><Icon name="notebook" size={14} />{ui.eyebrow}</span>
    <h1 style="margin-top:4px">{series.name}</h1>
    <p>{ui.blurb}</p>
  </div>
  {modules ? (
    <div class="series-modules">
      <nav class="series-jump" aria-label={ui.jump}>
        {modules.map((mod) => (
          <a href={`#${mod.id}`}>
            <span class="series-jump-n">{String(mod.index).padStart(2, "0")}</span>
            <span class="series-jump-label">{mod.title}</span>
          </a>
        ))}
      </nav>
      {modules.map((mod) => (
        <section class="series-module" id={mod.id}>
          <header class="series-module-head">
            <p class="series-module-kicker">{ui.module(mod.index)}</p>
            <h2 class="series-module-title">{mod.title}</h2>
          </header>
          {mod.posts.length > 0 ? (
            <ol class="series-toc">
              {mod.posts.map((post) => (
                <li>
                  <a href={blogHref(lang, postSlug(post.id))}>
                    <span class="series-toc-n">{articleOf(post)}</span>
                    <span class="series-toc-title">{post.data.title}</span>
                    <time class="series-toc-date" datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
                  </a>
                </li>
              ))}
            </ol>
          ) : (
            <p class="series-module-empty">{ui.empty}</p>
          )}
        </section>
      ))}
    </div>
  ) : (
    <div class="post-list archive-posts">
      {series.posts.map((post, i) => (
        <ArchiveCard
          href={blogHref(lang, postSlug(post.id))}
          date={fmt(post.data.date)}
          title={post.data.title}
          part={ui.part(i + 1)}
        />
      ))}
    </div>
  )}
</section>
