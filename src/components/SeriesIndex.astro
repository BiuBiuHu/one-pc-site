---
import Icon from "./Icon.astro";
import SeriesCards from "./SeriesCards.astro";

interface Props {
  lang: "zh" | "en";
  posts: any[];
}

const { lang, posts } = Astro.props;
const isEn = lang === "en";
const ui = isEn
  ? {
      eyebrow: "Columns",
      title: "Columns",
      blurb: "Structured learning paths — not another blog archive. Follow the modules in order."
    }
  : {
      eyebrow: "专栏",
      title: "专栏",
      blurb: "这里只放已经成体系的学习路径。按课程模块往下读，不是另一份博客归档。"
    };
---
<section class="page series-index">
  <div class="section-head">
    <span class="eyebrow"><Icon name="notebook" size={14} />{ui.eyebrow}</span>
    <h1 style="margin-top:4px">{ui.title}</h1>
    <p>{ui.blurb}</p>
  </div>
  <SeriesCards lang={lang} posts={posts} />
</section>
