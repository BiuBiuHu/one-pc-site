---
import { site, personNode } from "../data/site";

interface Props {
  post: any;
  lang: "zh" | "en";
  hasEn?: boolean;
}

const { post, lang, hasEn = false } = Astro.props;
const isEn = lang === "en";
const slug = post.id.replace(/-en$/, "");
const canonical = new URL(`${isEn ? "/en" : ""}/blog/${slug}/`, Astro.site).href;
const zhUrl = new URL(`/blog/${slug}/`, Astro.site).href;
const enUrl = new URL(`/en/blog/${slug}/`, Astro.site).href;
const showEnHreflang = isEn || hasEn;
const ogImage = new URL(post.data.ogImage || site.ogImage, Astro.site).href;
const datePublished = post.data.date;
const dateModified = post.data.updated || post.data.date;
const authorUrl = new URL(isEn ? "/en/about/" : "/about/", Astro.site).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.excerpt || undefined,
  datePublished: datePublished.toISOString(),
  dateModified: dateModified.toISOString(),
  url: canonical,
  mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
  author: personNode({ url: authorUrl, sameAs: site.sameAs }),
  publisher: personNode({ url: new URL("/", Astro.site).href }),
  inLanguage: isEn ? "en-US" : "zh-CN",
  image: ogImage
};
---
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
<link rel="alternate" hreflang="zh-CN" href={zhUrl} />
{showEnHreflang && <link rel="alternate" hreflang="en-US" href={enUrl} />}
<link rel="alternate" hreflang="x-default" href={zhUrl} />
