---
import Comments from "./Comments.astro";
import Icon from "./Icon.astro";
import RelatedReading from "./RelatedReading.astro";
import { render, getCollection } from "astro:content";
import { pickRelatedPosts, pickRelatedProject } from "../data/related.js";

interface Props {
  post: any;
  lang: "zh" | "en";
}

const { post, lang } = Astro.props;
const isEn = lang === "en";
const { Content, headings } = await render(post);
const tocItems = headings.filter((h) => h.depth >= 2 && h.depth <= 3);

const slug = post.id.replace(/-en$/, "");
const blogPath = isEn ? "/en/blog" : "/blog";
const dateLocale = isEn ? "en-US" : "zh-CN";
const fmt = (d) =>
  d.toLocaleDateString(dateLocale, { year: "numeric", month: "2-digit", day: "2-digit" }).replace(/\//g, "-");

const canonical = new URL(`${isEn ? "/en" : ""}/blog/${slug}/`, Astro.site).href;

const ui = isEn ? { back: "Back to blog", toc: "Contents" } : { back: "返回博客", toc: "目录" };
const shareText = encodeURIComponent(post.data.title);
const shareUrl = encodeURIComponent(canonical);
const shareUi = isEn
  ? { label: "Share", copy: "Copy link", copied: "Copied!" }
  : { label: "分享", copy: "复制链接", copied: "已复制" };
const allPosts = await getCollection("blog");
const series = post.data.series;
const seriesPosts = series
  ? allPosts
      .filter(
        (p) =>
          p.data.series === series &&
          (p.data.lang ?? "zh") === (isEn ? "en" : "zh") &&
          !p.data.draft
      )
      .sort((a, b) => a.data.date.getTime() - b.data.date.getTime())
  : [];
const seriesShown = seriesPosts.length > 1;
const relatedPosts = pickRelatedPosts(allPosts, post, {
  lang,
  limit: 3,
  skipSeries: seriesShown
});
const relatedProject = pickRelatedProject(post, lang);
const seriesUi = isEn ? { label: "Series" } : { label: "系列" };
---
<section class="page">
  <div class={`article-layout ${tocItems.length ? "has-toc" : ""}`}>
    {
      tocItems.length > 0 && (
        <aside class="toc">
          <a class="back-link" href={blogPath}>
            <Icon name="arrow-left" size={15} />{ui.back}
          </a>
          <div class="toc-label">{ui.toc}</div>
          <nav class="toc-nav">
            {tocItems.map((h) => (
              <a href={`#${h.slug}`} class={`toc-link toc-d${h.depth}`}>
                {h.text}
              </a>
            ))}
          </nav>
        </aside>
      )
    }

    <div class="article">
      {tocItems.length === 0 && (
        <a class="back-link" href={blogPath}><Icon name="arrow-left" size={15} />{ui.back}</a>
      )}
      {post.data.ogImage && (
        <img class="article-cover" src={post.data.ogImage} alt={post.data.title} loading="eager" />
      )}
      <header class="article-head">
        <div class="date">{fmt(post.data.date)}</div>
        <h1>{post.data.title}</h1>
      </header>
      <div class="prose">
        <Content />
      </div>
    </div>
  </div>
  {seriesShown && (
    <nav class="series-nav">
      <div class="series-label">{seriesUi.label} · {series}</div>
      <ol class="series-list">
        {seriesPosts.map((p) => {
          const isCurrent = p.id === post.id;
          const pSlug = p.id.replace(/-en$/, "");
          const href = isEn ? `/en/blog/${pSlug}/` : `/blog/${pSlug}/`;
          return (
            <li class:list={["series-item", { current: isCurrent }]}>
              {isCurrent ? <span>{p.data.title}</span> : <a href={href}>{p.data.title}</a>}
            </li>
          );
        })}
      </ol>
    </nav>
  )}
  <RelatedReading posts={relatedPosts} project={relatedProject} lang={lang} />
  <div class="share-box">
    <span class="share-label">{shareUi.label}</span>
    <a class="share-btn" href={`https://twitter.com/intent/tweet?text=${shareText}&url=${shareUrl}`} target="_blank" rel="noreferrer" aria-label="X">
      <Icon name="x" size={14} />
    </a>
    <button class="share-btn copy-btn" type="button" data-copied={shareUi.copied}>{shareUi.copy}</button>
  </div>
  <Comments slug={slug} />
</section>

<script>
  import mermaid from "mermaid";

  // 正文图 / mermaid 共用轻量 lightbox：暗色遮罩、居中放大，点遮罩 / Esc / 关闭按钮退出
  let activeLightbox = null;

  function closeLightbox() {
    if (!activeLightbox) return;
    document.removeEventListener("keydown", onLightboxKeydown);
    activeLightbox.remove();
    activeLightbox = null;
    document.body.style.overflow = "";
  }

  function onLightboxKeydown(e) {
    if (e.key === "Escape") {
      e.preventDefault();
      closeLightbox();
    }
  }

  function openLightbox(node) {
    closeLightbox();
    const isEn = document.documentElement.getAttribute("data-lang") === "en";
    const overlay = document.createElement("div");
    overlay.className = "zoom-lightbox";
    overlay.setAttribute("role", "dialog");
    overlay.setAttribute("aria-modal", "true");
    overlay.setAttribute("aria-label", isEn ? "Image preview" : "图片预览");

    const closeBtn = document.createElement("button");
    closeBtn.type = "button";
    closeBtn.className = "zoom-lightbox-close";
    closeBtn.setAttribute("aria-label", isEn ? "Close" : "关闭");
    closeBtn.innerHTML = "&times;";

    overlay.appendChild(node);
    overlay.appendChild(closeBtn);
    overlay.addEventListener("click", closeLightbox);
    closeBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      closeLightbox();
    });

    document.body.style.overflow = "hidden";
    document.body.appendChild(overlay);
    document.addEventListener("keydown", onLightboxKeydown);
    activeLightbox = overlay;
    closeBtn.focus();
  }

  function openImageLightbox(img) {
    const clone = document.createElement("img");
    clone.src = img.currentSrc || img.src;
    clone.alt = img.alt || "";
    openLightbox(clone);
  }

  // 仅正文图：跳过链接里的图、封面、导航小图标
  document.querySelectorAll(".prose img").forEach((img) => {
    if (img.closest("a")) return;
    img.classList.add("zoomable");
    img.setAttribute("tabindex", "0");
    const open = () => openImageLightbox(img);
    img.addEventListener("click", open);
    img.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        open();
      }
    });
  });

  // mermaid 代码块渲染：把 <pre data-language="mermaid"> 替换成 SVG 图（本地打包，不依赖 CDN）
  const blocks = document.querySelectorAll('pre[data-language="mermaid"]');
  if (blocks.length) {
    mermaid.initialize({ startOnLoad: false, theme: "default" });
    let i = 0;
    blocks.forEach((pre) => {
      const codeEl = pre.querySelector("code");
      const code = codeEl ? codeEl.textContent : pre.textContent;
      mermaid
        .render("mermaid-" + i++, code)
        .then((r) => {
          const wrap = document.createElement("div");
          wrap.className = "mermaid-wrap";
          wrap.innerHTML = r.svg;
          pre.replaceWith(wrap);
          const svg = wrap.querySelector("svg");
          if (svg) {
            svg.style.cursor = "zoom-in";
            svg.addEventListener("click", () => openLightbox(svg.cloneNode(true)));
          }
        })
        .catch((e) => {
          console.error("mermaid render failed:", e);
        });
    });
  }

  // 复制链接按钮
  document.querySelectorAll(".copy-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(location.href);
        const original = btn.textContent;
        btn.textContent = btn.getAttribute("data-copied");
        setTimeout(() => (btn.textContent = original), 1500);
      } catch (e) {
        console.error("copy failed:", e);
      }
    });
  });
</script>
